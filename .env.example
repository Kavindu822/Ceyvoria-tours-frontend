# ==============================================================================
# CEYVORIA TOURS — FRONTEND ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# Copy this file to `.env.local` for local development, or add these variables
# to your hosting provider's dashboard (e.g. Vercel, Netlify, Render, AWS, Docker).

# ------------------------------------------------------------------------------
# 1. CORE SITE & API URLS
# ------------------------------------------------------------------------------
# Public URL of your deployed site (used for OpenGraph, sitemaps, canonical tags, etc.)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# URL of the ASP.NET Core backend API.
# Leave blank to browse in offline/standalone editorial mode (using bundled JSON).
# In production, set to your backend URL (e.g. https://api.ceyvoria.com or https://ceyvoria-api.onrender.com)
NEXT_PUBLIC_API_URL=http://localhost:5050

# ------------------------------------------------------------------------------
# 2. BRANDING & CONTACT CHANNELS (Dynamic on all pages)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_NAME=CEYVORIA TOURS
NEXT_PUBLIC_SITE_TAGLINE=Discover the Soul of Sri Lanka
NEXT_PUBLIC_SITE_HEADLINE=Discover Sri Lanka, Beautifully.
NEXT_PUBLIC_SITE_SUBTITLE=Private, tailor-made journeys through Sri Lanka's most extraordinary places.

# Official contact inquiries email
NEXT_PUBLIC_CONTACT_EMAIL=ceyvoriatours@gmail.com

# Formatted phone number displayed in header/footer/contact cards
NEXT_PUBLIC_CONTACT_PHONE=+94 76 781 0420

# Raw numeric phone number for tel: links (country code + number, no spaces)
NEXT_PUBLIC_CONTACT_PHONE_RAW=+94767810420

# Formatted WhatsApp display number
NEXT_PUBLIC_WHATSAPP=+94 76 781 0420

# Raw numeric WhatsApp number for wa.me links (country code + number, no '+' or spaces)
NEXT_PUBLIC_WHATSAPP_RAW=94767810420

# Physical business address & headquarters
NEXT_PUBLIC_LOCATION=Colombo, Sri Lanka
NEXT_PUBLIC_ADDRESS=No. 28/4, Alfred Place, Colombo 03, Sri Lanka

# ------------------------------------------------------------------------------
# 3. REVIEWS & SOCIAL PROFILES (Optional)
# ------------------------------------------------------------------------------
# Official TripAdvisor profile link
NEXT_PUBLIC_TRIPADVISOR_URL=

# ------------------------------------------------------------------------------
# 4. ANALYTICS & MONITORING (Optional)
# ------------------------------------------------------------------------------
# Google Analytics 4 Measurement ID (e.g., G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# ------------------------------------------------------------------------------
# 5. DIALOG GENIE PAYMENT GATEWAY (Optional - For Pay Advance & Booking)
# ------------------------------------------------------------------------------
# Set to 'live' for production transactions or 'sandbox' for sandbox testing
DIALOG_GENIE_ENV=sandbox
DIALOG_GENIE_MERCHANT_ID=
DIALOG_GENIE_APP_ID=
DIALOG_GENIE_SECRET_KEY=
# Set to true when live production credentials are verified
DIALOG_GENIE_LIVE_ACTIVE=false
DIALOG_GENIE_LIVE_URL=https://pg.genie.lk
DIALOG_GENIE_SANDBOX_URL=https://pg-sandbox.genie.lk
